config_version=5

[application]
config/name="ROGUE MACHINES: LOST SIGNAL"
config/icon="res://icon.svg"
config/version="0.2.0"
config/description="Cooperative LAN salvage horror. Recover the signal. Bring the crew home."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[audio]
default_bus_layout="res://default_bus_layout.tres"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.012, 0.02, 0.032, 1)

[physics]
3d/default_gravity=20.0

[application/run]
low_processor_mode=false

[debug]
gdscript/warnings/untyped_declaration=1
